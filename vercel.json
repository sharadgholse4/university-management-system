{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/app.js", "destination": "/app.js" },
    { "source": "/public/(.*)", "destination": "/public/$1" },
    { "source": "/frontend/(.*)", "destination": "/frontend/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
